@{
    ViewData["Title"] = "Trang chủ";
}

<section class="pos-card" style="margin-bottom: 1rem;">
    <h2 class="pos-h2">Retail Core POS</h2>
    <p class="pos-muted">
        Khung nền ứng dụng ASP.NET Core MVC (.NET 8) cho cửa hàng bán lẻ gồm hai phân hệ
        Quầy (TV1) và Kho &amp; Hệ thống (TV2), dùng chung một bố cục thanh điều hướng 8 nhóm chức năng F1–F8.
    </p>
</section>

<div class="pos-grid">
    <article class="pos-card">
        <h2 class="pos-h2">Phân hệ Quầy (TV1)</h2>
        <p class="pos-muted">
            Phụ trách F3 (Bán hàng &amp; Thu tiền), F4 (Nhận trả &amp; Hoàn tiền),
            F7 (Quản lý ca &amp; Sổ quỹ) và các báo cáo F8.1, F8.2, F8.4.
        </p>
    </article>

    <article class="pos-card">
        <h2 class="pos-h2">Phân hệ Kho &amp; Hệ thống (TV2)</h2>
        <p class="pos-muted">
            Phụ trách F1 (Quản trị &amp; RBAC), F2 (Danh mục), F5 (Nhập hàng &amp; Trả NCC),
            F6 (Kiểm soát tồn kho) và các báo cáo F8.3, F8.5.
        </p>
    </article>
</div>
