@model KyBaoCaoViewModel
@{
    var tu = ViewData.ModelState["tu"] is { Errors.Count: > 0 } tuLoi ? tuLoi.AttemptedValue : Model.Tu.ToString("dd/MM/yyyy");
    var den = ViewData.ModelState["den"] is { Errors.Count: > 0 } denLoi ? denLoi.AttemptedValue : Model.Den.ToString("dd/MM/yyyy");
}
<label>Từ ngày<input class="pos-input" type="text" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" name="tu" value="@tu" required /></label>
<label>Đến ngày<input class="pos-input" type="text" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" name="den" value="@den" required /></label>
<div asp-validation-summary="All" class="kho-validation" role="alert"></div>
