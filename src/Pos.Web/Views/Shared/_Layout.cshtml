@inject KhoDemoSessionProvider KhoSessions
@{
    var khoUser = ViewData["KhoDanhTinh"] as DanhTinhKhoDemo ?? KhoSessions.DanhTinhHienTai(Context);
    var pageTitle = ViewData["Title"] as string ?? "Retail Core POS";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var stackHeaderOnMobile = currentController is "BanHang" or "HeThong" or "NhomHang" or "MatHang" or "NhaCungCap"
        or "NhapHang" or "KiemKho" or "BaoCao";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isBanHangPos = string.Equals(currentController, "BanHang", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isTraCuuHoaDon = string.Equals(currentController, "BanHang", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "TraCuu", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · Retail Core POS</title>
    <link rel="stylesheet" href="~/css/pos-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pos-kho.css" asp-append-version="true" />
</head>
<body>
    <div class="pos-shell">
        <aside class="pos-sidebar" id="pos-sidebar" aria-label="Điều hướng nghiệp vụ POS">
            <div class="pos-brand">
                <a class="pos-brand-link" asp-controller="Home" asp-action="Index">
                    <span class="pos-brand-mark" aria-hidden="true">
                        <svg class="pos-icon"><use href="@Url.Content("~/images/pos-icons.svg")#icon-brand"></use></svg>
                    </span>
                    <span>
                        <span class="pos-brand-title">Retail Core POS</span>
                        <span class="pos-brand-sub">Hệ thống bán lẻ &amp; kho</span>
                    </span>
                </a>
                <button type="button" class="pos-sidebar-close" id="pos-sidebar-close" aria-label="Đóng thanh điều hướng">
                    <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-close"></use></svg>
                </button>
            </div>

            <nav class="pos-nav" aria-label="8 nhóm chức năng POS">
                <div class="pos-nav-group">
                    <a class="pos-nav-item @(isHome ? "is-active" : string.Empty)" asp-controller="Home" asp-action="Index">
                        <span class="pos-nav-item-label">
                            <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-home"></use></svg>
                            <span>Trang chủ</span>
                        </span>
                    </a>
                </div>

                <section class="pos-nav-group" aria-label="F1 Quản trị hệ thống">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f1"></use></svg>
                        <span>F1 · Quản trị hệ thống</span>
                    </h2>
                    <partial name="_KhoNav" model='(("HeThong", "DangNhap", "Đăng nhập hệ thống POS", currentController == "HeThong" && (currentAction == "DangNhap"), true))' />
                    <partial name="_KhoNav" model='(("HeThong", "TaiKhoan", "Quản lý tài khoản nhân sự", currentController == "HeThong" && (currentAction == "TaiKhoan" || currentAction == "SuaTaiKhoan"), khoUser is null || khoUser.CoQuyen("HT_QL_TAI_KHOAN")))' />
                    <partial name="_KhoNav" model='(("HeThong", "PhanQuyen", "Cấu hình phân quyền vai trò", currentController == "HeThong" && (currentAction == "PhanQuyen"), khoUser is null || khoUser.CoQuyen("HT_PHAN_QUYEN")))' />
                </section>

                <section class="pos-nav-group" aria-label="F2 Quản lý danh mục">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f2"></use></svg>
                        <span>F2 · Quản lý danh mục</span>
                    </h2>
                    <partial name="_KhoNav" model='(("NhomHang", "Index", "Nhóm hàng", currentController == "NhomHang" && (currentAction == "Index" || currentAction == "Sua"), khoUser is null || khoUser.CoQuyen("DM_NHOM_XEM")))' />
                    <partial name="_KhoNav" model='(("MatHang", "Index", "Mặt hàng", currentController == "MatHang" && (currentAction == "Index" || currentAction == "Sua"), khoUser is null || khoUser.CoQuyen("DM_HANG_XEM")))' />
                    <partial name="_KhoNav" model='(("NhaCungCap", "Index", "Nhà cung cấp", currentController == "NhaCungCap" && (currentAction == "Index" || currentAction == "Sua"), khoUser is null || khoUser.CoQuyen("DM_NCC_XEM")))' />
                </section>

                <section class="pos-nav-group" aria-label="F3 Bán hàng và Thu tiền">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f3"></use></svg>
                        <span>F3 · Bán hàng &amp; Thu tiền</span>
                    </h2>
                    <a class="pos-nav-item @(isBanHangPos ? "is-active" : string.Empty)" asp-controller="BanHang" asp-action="Index">
                        <span>Màn hình Bán hàng POS</span>
                    </a>
                    <a class="pos-nav-item @(isTraCuuHoaDon ? "is-active" : string.Empty)" asp-controller="BanHang" asp-action="TraCuu">
                        <span>Tra cứu, in và hủy hóa đơn</span>
                    </a>
                </section>

                <section class="pos-nav-group" aria-label="F4 Nhận trả và Hoàn tiền">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f4"></use></svg>
                        <span>F4 · Nhận trả &amp; Hoàn tiền</span>
                    </h2>
                    <a class="pos-nav-item @(currentController == "TraHang" && currentAction == "Index" ? "is-active" : "")" asp-controller="TraHang" asp-action="Index">Lập phiếu trả &amp; Hoàn tiền</a>
                    <a class="pos-nav-item @(currentController == "TraHang" && currentAction == "TraCuu" ? "is-active" : "")" asp-controller="TraHang" asp-action="TraCuu">Tra cứu phiếu trả hàng</a>
                </section>

                <section class="pos-nav-group" aria-label="F5 Nhập hàng và Trả tiền">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f5"></use></svg>
                        <span>F5 · Nhập hàng &amp; Trả tiền</span>
                    </h2>
                    <partial name="_KhoNav" model='(("NhapHang", "Lap", "Lập phiếu nhập kho", currentController == "NhapHang" && (currentAction == "Lap"), khoUser is null || khoUser.CoQuyen("NHAP_LAP_NHAP")))' />
                    <partial name="_KhoNav" model='(("NhapHang", "Index", "Sổ phiếu nhập và trả tiền NCC", currentController == "NhapHang" && (currentAction == "Index" || currentAction == "ChiTiet"), khoUser is null || khoUser.CoQuyen("NHAP_TRA_CUU")))' />
                </section>

                <section class="pos-nav-group" aria-label="F6 Kiểm soát tồn kho">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f6"></use></svg>
                        <span>F6 · Kiểm soát tồn kho</span>
                    </h2>
                    <partial name="_KhoNav" model='(("KiemKho", "TheKho", "Sổ chi tiết hàng hóa (Thẻ kho)", currentController == "KiemKho" && (currentAction == "TheKho"), khoUser is null || khoUser.CoQuyen("KHO_TRA_SO_HANG")))' />
                    <partial name="_KhoNav" model='(("KiemKho", "Index", "Phiếu kiểm kê và cân chỉnh tồn", currentController == "KiemKho" && (currentAction == "Index" || currentAction is "ChiTiet" or "Lap"), khoUser is null || khoUser.CoQuyen("KHO_XEM_XET_KIEM")))' />
                </section>

                <section class="pos-nav-group" aria-label="F7 Quản lý ca và Sổ quỹ">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f7"></use></svg>
                        <span>F7 · Quản lý ca &amp; Sổ quỹ</span>
                    </h2>
                    <a class="pos-nav-item @(currentController == "CaBan" && currentAction == "Index" ? "is-active" : "")" asp-controller="CaBan" asp-action="Index">Quản lý ca &amp; Bàn giao két</a>
                    <a class="pos-nav-item @(currentController == "CaBan" && currentAction == "SoQuy" ? "is-active" : "")" asp-controller="CaBan" asp-action="SoQuy">Sổ quỹ &amp; Thu chi tiền mặt</a>
                </section>

                <section class="pos-nav-group" aria-label="F8 Báo cáo thống kê">
                    <h2 class="pos-nav-heading">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-f8"></use></svg>
                        <span>F8 · Báo cáo thống kê</span>
                    </h2>
                    <span class="pos-nav-item is-disabled" aria-disabled="true">
                        <span>Báo cáo cuối ngày &amp; Bán trả</span>
                        <span class="pos-nav-tag">Sắp có</span>
                    </span>
                    <partial name="_KhoNav" model='(("BaoCao", "XuatNhapTon", "Thống kê xuất, nhập, tồn", currentController == "BaoCao" && (currentAction == "XuatNhapTon"), khoUser is null || khoUser.CoQuyen("BC_XUAT_NHAP_TON")))' />
                    <partial name="_KhoNav" model='(("BaoCao", "CongNoNcc", "Nhập hàng và công nợ NCC", currentController == "BaoCao" && (currentAction == "CongNoNcc"), khoUser is null || khoUser.CoQuyen("BC_NHAP_CONG_NO")))' />
                </section>
            </nav>
        </aside>

        <div class="pos-backdrop" id="pos-backdrop" aria-hidden="true"></div>

        <div class="pos-main">
            <header class="pos-header @(stackHeaderOnMobile ? "pos-header-stack" : null)">
                <div class="pos-header-left">
                    <button type="button" class="pos-menu-btn" id="pos-menu-toggle" aria-controls="pos-sidebar" aria-expanded="false" aria-label="Mở thanh điều hướng">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-menu"></use></svg>
                    </button>
                    <h1 class="pos-page-title">@pageTitle</h1>
                </div>
                <div class="pos-header-meta">
                    <span class="pos-pill">
                        <svg class="pos-icon" aria-hidden="true"><use href="@Url.Content("~/images/pos-icons.svg")#icon-store"></use></svg>
                        <span>1 cửa hàng · 1 kho</span>
                    </span>
                    @if (khoUser is null)
                    {
                        <a class="pos-pill pos-pill-teal" asp-controller="HeThong" asp-action="DangNhap">Đăng nhập demo</a>
                    }
                    else
                    {
                        <span class="pos-pill pos-pill-teal">Demo · @khoUser.HoTen · @KhoDemoStore.VaiTros[khoUser.VaiTro]</span>
                        <form asp-controller="HeThong" asp-action="DangXuat" method="post">
                            <button class="pos-btn pos-btn-ghost" type="submit">Đăng xuất</button>
                        </form>
                    }
                </div>
            </header>

            <main class="pos-content" id="main-content">
                @if (TempData["KhoSuccess"] is string msg)
                { <p class="kho-feedback" role="status">@msg</p> }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/pos-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
