@model Pos.Web.ViewModels.CaBan.CaBanViewModel
@{
    var loc = Model.Loc;
    var xemSoQuy = ViewContext.RouteData.Values["action"]?.ToString() == "SoQuy";
}
@if (ViewData["F7FilterError"] is string loi)
{
    <p class="pos-alert pos-alert-error" role="alert">@loi</p>
}
<form method="get" class="pos-card pos-filter-grid">
    @if (xemSoQuy)
    {
        <label>Ca bán
            <select name="Chon" class="pos-input">
                <option value="">Tất cả</option>
                @foreach (var ca in Model.CacCa)
                {
                    <option value="@ca.MaCa" selected="@(string.Equals(loc.Chon, ca.MaCa, StringComparison.OrdinalIgnoreCase))">@ca.MaCa</option>
                }
            </select>
        </label>
        <label>Phương thức
            <select name="PhuongThuc" class="pos-input">
                <option value="">Tất cả</option>
                <option value="TienMat" selected="@(loc.PhuongThuc == "TienMat")">Tiền mặt</option>
                <option value="ChuyenKhoan" selected="@(loc.PhuongThuc == "ChuyenKhoan")">Chuyển khoản</option>
            </select>
        </label>
    }
    else
    {
        <label>Mã ca <input class="pos-input" name="Ma" value="@loc.Ma" /></label>
        <label>Trạng thái
            <select name="TrangThai" class="pos-input">
                <option value="">Tất cả</option>
                <option value="DangMo" selected="@(loc.TrangThai == "DangMo")">Đang mở</option>
                <option value="DaDong" selected="@(loc.TrangThai == "DaDong")">Đã đóng</option>
            </select>
        </label>
    }
    <label>Từ ngày <input class="pos-input" type="date" name="Tu" value="@loc.Tu?.ToString("yyyy-MM-dd")" /></label>
    <label>Đến ngày <input class="pos-input" type="date" name="Den" value="@loc.Den?.ToString("yyyy-MM-dd")" /></label>
    <button class="pos-btn pos-btn-secondary">Tra cứu</button>
</form>
