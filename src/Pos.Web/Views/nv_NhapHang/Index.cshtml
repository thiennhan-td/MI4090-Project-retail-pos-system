@model SoNhapViewModel
@{
    ViewData["Title"] = "Sổ phiếu nhập";
    var tu = ViewData.ModelState["tu"] is { Errors.Count: > 0 } tuLoi ? tuLoi.AttemptedValue : Model.Tu?.ToString("dd/MM/yyyy");
    var den = ViewData.ModelState["den"] is { Errors.Count: > 0 } denLoi ? denLoi.AttemptedValue : Model.Den?.ToString("dd/MM/yyyy");
    var user = ViewData["KhoDanhTinh"] as DanhTinhKhoDemo;
}
<div class="kho-toolbar">
    <p>Tra cứu phiếu nhập theo nhà cung cấp và theo dõi khoản phải trả.</p>
    @if (user?.CoQuyen("NHAP_LAP_NHAP") == true)
    {
        <a class="pos-btn pos-btn-primary" asp-action="Lap">Lập phiếu nhập</a>
    }
</div>
<form asp-action="Index" method="get" class="kho-card kho-filters">
    <label>Tìm phiếu hoặc NCC<input class="pos-input" name="tuKhoa" value="@Model.TuKhoa" type="search" placeholder="Mã phiếu hoặc tên NCC" /></label>
    <label>Nhà cung cấp<select class="pos-input" name="maNcc">
        <option value="">Tất cả nhà cung cấp</option>
        @foreach (var ncc in Model.NhaCungCaps)
        {
            <option value="@ncc.Ma" selected="@(ncc.Ma == Model.MaNcc)">@ncc.Ten</option>
        }
    </select></label>
    <label>Trạng thái<select class="pos-input" name="trangThai">
        <option value="">Tất cả trạng thái</option>
        @foreach (var status in new[] { "Nhap", "DaXacNhan", "DaHuy" })
        {
            <option value="@status" selected="@(status == Model.TrangThai)">@HienThiKho.Nhan(status)</option>
        }
    </select></label>
    <label>Từ ngày<input class="pos-input" type="text" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" name="tu" value="@tu" /></label>
    <label>Đến ngày<input class="pos-input" type="text" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" name="den" value="@den" /></label>
    <div asp-validation-summary="All" class="kho-validation"></div>
    <button type="submit" class="pos-btn pos-btn-secondary">Lọc phiếu</button>
</form>
<div class="kho-card">
    <div class="kho-card-head">
        <h2>Danh sách phiếu nhập <span class="kho-badge">@Model.Dongs.Count</span></h2>
        @if (Model.TongNo is decimal no) { <strong>Dư nợ các phiếu hiển thị <span class="kho-num">@HienThiKho.Tien(no)</span></strong> }
    </div>
    <div class="pos-table-wrap">
        <table class="pos-table kho-table">
            <thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Ngày lập</th><th>Trạng thái</th><th class="kho-num">Tổng tiền</th>
                @if (Model.TongNo is not null) { <th class="kho-num">Dư nợ</th> }
            </tr></thead>
            <tbody>
            @foreach (var dong in Model.Dongs)
            {
                var phieu = dong.Phieu;
                <tr>
                    <td><a asp-action="ChiTiet" asp-route-id="@phieu.Ma">@phieu.Ma</a></td>
                    <td>@dong.TenNcc</td><td>@KhoDemoStore.HienThiNgayGio(phieu.LucLap)</td>
                    <td><span class="@HienThiKho.Mau(phieu.TrangThai)">@HienThiKho.Nhan(phieu.TrangThai)</span></td>
                    <td class="kho-num">@HienThiKho.Tien(phieu.TongTien)</td>
                    @if (dong.DuNo is decimal duNo) { <td class="kho-num">@HienThiKho.Tien(duNo)</td> }
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Dongs.Count == 0) { <p class="kho-empty">Không tìm thấy phiếu nhập.</p> }
</div>
